<?xml version="1.0" encoding="utf-8"?>
<project version="2">
  <!-- Output SWF options -->
  <output>
    <movie outputType="CustomBuild" />
    <movie input="" />
    <movie path="project.xml" />
    <movie fps="60" />
    <movie width="800" />
    <movie height="480" />
    <movie version="1" />
    <movie minorVersion="0" />
    <movie platform="Lime" />
    <movie background="000000" />
    <movie preferredSDK=";3.1.3;" />
  </output>
  <!-- Other classes to be compiled into your SWF -->
  <classpaths>
    <class path="C:\HaxeToolkit\haxe\lib\openfl\4,3,1" />
    <class path="C:\HaxeToolkit\haxe\lib\lime\3,3,0" />
    <class path="C:\HaxeToolkit\haxe\lib\actuate\1,8,7" />
    <class path="C:\HaxeToolkit\haxe\lib\polygonal-ds\2,0,0-beta\src" />
    <class path="C:\HaxeToolkit\haxe\lib\polygonal-printf\1,0,2-beta" />
    <class path="C:\HaxeToolkit\haxe\lib\edge\git\src" />
    <class path="C:\HaxeToolkit\haxe\lib\thx,core\0,40,1\src" />
    <class path="C:\HaxeToolkit\haxe\lib\box2d\1,2,3" />
    <class path="C:\HaxeToolkit\haxe\lib\thx,core\0,27,0\src" />
    <class path="src" />
    <class path="c:\HaxeToolkit\haxe\lib\openfl\4,3,1\externs\core\flash" />
    <class path="c:\HaxeToolkit\haxe\lib\openfl\4,3,1\externs\core\openfl" />
    <class path="c:\HaxeToolkit\haxe\lib\openfl\4,3,1\externs\extras" />
    <class path="bin\flash\debug\haxe" />
  </classpaths>
  <!-- Build options -->
  <build>
    <option directives="openfl=4.3.1&#xA;lime=3.3.0&#xA;actuate=1.8.7&#xA;polygonal-ds=2.0.0-beta&#xA;polygonal-printf=1.0.2-beta&#xA;edge=0.7.0&#xA;thx.core=0.40.1&#xA;box2d=1.2.3&#xA;thx_core&#xA;thx.core=0.27.0&#xA;tools=3.3.0&#xA;no-compilation&#xA;openfl-flash&#xA;web&#xA;display" />
    <option flashStrict="False" />
    <option noInlineOnDebug="False" />
    <option mainClass="ApplicationMain" />
    <option enabledebug="True" />
    <option additional="--macro openfl.Lib.extraParams()&#xA;--macro lime.Lib.extraParams()&#xA;-swf-version 11.2&#xA;-debug " />
  </build>
  <!-- haxelib libraries -->
  <haxelib>
    <library name="thx.core" />
  </haxelib>
  <!-- Class files to compile (other referenced classes will automatically be included) -->
  <compileTargets>
    <compile path="src\Main.hx" />
  </compileTargets>
  <!-- Paths to exclude from the Project Explorer tree -->
  <hiddenPaths>
    <hidden path="obj" />
  </hiddenPaths>
  <!-- Executed before build -->
  <preBuildCommand>"$(CompilerPath)/haxelib" run lime build "$(OutputFile)" $(TargetBuild) -$(BuildConfig) -Dfdb</preBuildCommand>
  <!-- Executed after build -->
  <postBuildCommand alwaysRun="False" />
  <!-- Other project options -->
  <options>
    <option showHiddenPaths="False" />
    <option testMovie="Custom" />
    <option testMovieCommand="" />
  </options>
  <!-- Plugin storage -->
  <storage />
</project>